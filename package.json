{
  "name": "@ippoan/mcp-cf-workers",
  "version": "0.4.0",
  "description": "Thin building blocks for MCP servers on Cloudflare Workers.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./durable": "./src/durable.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/cf-access": "./src/auth/cf-access.ts",
    "./auth/cf-access-hono": "./src/auth/cf-access-hono.ts",
    "./auth/mcp-jwt": "./src/auth/mcp-jwt.ts",
    "./auth/mcp-jwt-hono": "./src/auth/mcp-jwt-hono.ts",
    "./auth/hs256-jwt": "./src/auth/hs256-jwt.ts",
    "./auth/crypto": "./src/auth/crypto.ts",
    "./auth/secret": "./src/auth/secret.ts",
    "./auth/binding-jwt": "./src/auth/binding-jwt.ts",
    "./auth/binding-jwt-hono": "./src/auth/binding-jwt-hono.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CLAUDE.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": "github:ippoan/mcp-cf-workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.13.0",
    "hono": "^4.12.0",
    "jose": "^5.0.0 || ^6.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "agents": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@vitest/coverage-istanbul": "^4.1.2",
    "agents": "^0.13.3",
    "hono": "^4.12.12",
    "jose": "^6.1.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  }
}
